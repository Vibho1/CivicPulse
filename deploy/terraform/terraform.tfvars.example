# Copy to terraform.tfvars (git-ignored) and edit. Only project_id is required.
project_id = "your-project-id"

# region         = "asia-south1"        # Mumbai, closest to Bengaluru
# service_name   = "civicpulse"
# gemini_backend = "vertex"             # vertex | apikey | off
# gemini_model   = "gemini-3.8-flash"
# public         = true                 # false + invokers = ["user:you@example.com"] for a private service
# demo_mode      = false                # true lets anyone with the URL seed/reset the data
# min_instances  = 0                    # 1 = no cold starts, but the idle instance is billed
# extra_env      = { DUPLICATE_WINDOW_S = "0" }

# Run Terraform as a deployer service account instead of your own user (see docs/DEPLOY_GCP.md):
# deployer_service_account = "terraform-deployer@your-project-id.iam.gserviceaccount.com"

# API-key mode instead of Vertex AI (the secret must already exist in Secret Manager):
# gemini_backend        = "apikey"
# gemini_api_key_secret = "gemini-api-key"

# After the first apply, set this to the service_url output (or your domain) and apply again:
# public_base_url = "https://civicpulse-xxxxxxxx-el.a.run.app"
# public_audio    = false               # true shows citizens' voice notes on public issue pages

# WhatsApp intake (docs/WHATSAPP.md). Create the secrets and add their values first:
# whatsapp_verify_token_secret = "whatsapp-verify-token"
# whatsapp_app_secret_secret   = "whatsapp-app-secret"
# whatsapp_access_token_secret = "whatsapp-access-token"
# whatsapp_phone_number_id     = "123456789012345"
