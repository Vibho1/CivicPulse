# Copy to .env (repo root or backend/) and fill in.

# Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run fully offline with the heuristic parser (no transcription / vision,
# no face/plate blurring).
GEMINI_API_KEY=
# gemini-2.5-flash works with AI Studio keys; on Vertex AI use a Gemini 3 Flash model
# (e.g. gemini-3.8-flash). Gemini 3 models run with minimal/low thinking to keep intake fast.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=60
# Report parsing gives up on the model after this long and falls back to the offline parser
# (PRD: intake p95 under 5 s).
# GEMINI_PARSE_TIMEOUT_S=15

# ...or use Gemini on Vertex AI instead of a key, authenticated with Application Default
# Credentials (the Cloud Run service account, or `gcloud auth application-default login` locally).
# GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Storage (defaults are fine for local dev)
# DATABASE_PATH=backend/data/civicpulse.db
# UPLOADS_DIR=backend/data/uploads
# Cloud Run only (set by the Terraform in deploy/terraform): stream the SQLite DB to Cloud Storage with Litestream
# LITESTREAM_REPLICA_URL=gcs://your-bucket/db/civicpulse.db

# HTTP
CORS_ORIGINS=*
# Absolute base URL used in media links and WhatsApp replies when served behind a different host
# (optional; escalation drafts fall back to the request's own URL)
PUBLIC_BASE_URL=

# Privacy: voice notes can identify a person, so they are only shown on public issue pages
# when this is on (the reporter always gets their own playback).
# PUBLIC_AUDIO=false

# Enables /api/admin/seed and /api/admin/reset
DEMO_MODE=true
# Load the Bengaluru demo story at startup when the database is empty (fresh deployments)
# SEED_ON_STARTUP=false

# Intake limits (PRD: photo up to 10 MB, voice note up to 30 s)
# MAX_IMAGE_MB=10
# MAX_AUDIO_MB=10
# MAX_AUDIO_S=30

# Anti-spam: reject the same reporter filing the same category within this radius
# and window (PRD: 1 km / 5 min). Set either to 0 to disable, e.g. for rehearsing a demo.
# DUPLICATE_WINDOW_S=300
# DUPLICATE_RADIUS_M=1000

# Optional webhook (e.g. a WhatsApp / SMS bridge) that receives "send a proof photo"
# requests when an official marks an issue resolved. The in-app inbox works without it.
NOTIFY_WEBHOOK_URL=

# Optional WhatsApp Cloud API intake (docs/WHATSAPP.md). Off unless the verify token is set.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v21.0
