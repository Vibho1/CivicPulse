# Copy to .env (repo root or backend/) and fill in.

# Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run fully offline with the heuristic parser (no transcription / vision).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=60

# Storage (defaults are fine for local dev)
# DATABASE_PATH=backend/data/civicpulse.db
# UPLOADS_DIR=backend/data/uploads

# HTTP
CORS_ORIGINS=*
# Absolute base URL used in media links when served behind a different host (optional)
PUBLIC_BASE_URL=

# Enables /api/admin/seed and /api/admin/reset
DEMO_MODE=true
